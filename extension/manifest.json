{
	"manifest_version": 3,
	"name": "Locus Bridge",
	"version": "0.4.0",
	"description": "Lets the Locus page list, open, read and control tabs, and fetch web pages.",
	"key": "",
	"permissions": ["tabs", "scripting", "debugger"],
	"host_permissions": ["<all_urls>"],
	"background": { "service_worker": "bridge.js" },
	"externally_connectable": { "matches": ["https://locus.dontpanicv.com/*", "http://localhost/*", "http://127.0.0.1/*"] }
}
